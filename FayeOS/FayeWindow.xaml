<Window x:Class="FayeOS.FayeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FayeOS"
        mc:Ignorable="d"
        PreviewMouseDown="Window_PreviewMouseDown"
        Title="FayeOS" Height="720" Width="1200"
        MinWidth="1000" MinHeight="650"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#07111f" Offset="0"/>
                <GradientStop Color="#0b1d33" Offset="0.55"/>
                <GradientStop Color="#07111f" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row ="0"
           Text="FayeOS"
           Foreground="{StaticResource FayeTextPrimary}"
           FontSize="32"
           FontWeight="Light"
           VerticalAlignment="Center"
           Margin="30,0,30,0"/>
        <Ellipse Grid.Row="0"
                 Grid.RowSpan="3"
                 Width="420"
                 Height="420"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Top"
                 Margin="0, -120, -80, 0">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#504da3ff" 
                                  Offset="0"/>
                    <GradientStop Color="#004da3ff"
                                  Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Grid.Row="0"
                 Grid.RowSpan="3"
                 Width="300"
                 Height="300"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Bottom"
                 Margin="-80, 0, 0, -100">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#307dd3fc" 
                                  Offset="0"/>
                    <GradientStop Color="#007dd3fc"
                                  Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Grid Grid.Row="1"
              Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    Style="{StaticResource FayePanelStyle}"
                    Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="SYSTEM"
                               Foreground="{StaticResource FayeTextSecondary}"
                               FontSize="14"/>
                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal">
                        <Ellipse Width="8"
                                 Height="8"
                                 Fill="{StaticResource FayeAccent}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0"/>
                        <TextBlock Text="ONLINE"
                                       Foreground="{StaticResource FayeTextPrimary}"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Row="3"
                                Orientation="Vertical"
                                Margin="0,12,0,0">
                        
                        <TextBlock Text="CPU"
                                       Foreground="{StaticResource FayeTextSecondary}"
                                       FontSize="11"/>
                        <TextBlock x:Name="cpuUsageText"
                                   Text="{Binding CpuUsage, StringFormat={}{0:0}%}"
                                   Foreground="{StaticResource FayeTextPrimary}"
                                   FontSize="22"
                                   FontWeight="Light"
                                   Margin="0,2,0,0"/>
                        <ProgressBar Style="{StaticResource FayeProgressBarStyle}"
                                     x:Name="CpuProgressBar"
                                     Value="{Binding CpuUsage}"
                                     Maximum="100"
                                     Height="5"
                                     Margin="0,8,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Row="4"
                                Orientation="Vertical"
                                Margin="0,12,0,0">
                        <TextBlock Text="RAM"
                                       Foreground="{StaticResource FayeTextSecondary}"
                                       FontSize="11"/>
                        <TextBlock x:Name="RamUsageText"
                                   Text="{Binding RamUsage, StringFormat={}{0:0}%}"
                                   Foreground="{StaticResource FayeTextPrimary}"
                                   FontSize="22"
                                   FontWeight="Light"
                                   Margin="0,2,0,0"/>
                        <ProgressBar x:Name="RamProgressBar"
                                     Value="{Binding RamUsage}"
                                     Maximum="100"
                                     Height="5"
                                     Margin="0,8,0,0"
                                     Style="{StaticResource FayeProgressBarStyle}"/>
                        <TextBlock x:Name="RamTotalText"
                                   Foreground="{StaticResource FayeTextSecondary}"
                                   Margin="0,8,0,0">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0:0.00} GB / {1:0.00} GB">
                                    <Binding Path="RamUsedGB"/>
                                    <Binding Path="RamTotalGB"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                                   
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="1"
                    Style="{StaticResource FayePanelStyle}"
                    Margin="10,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="FAYEWORKSPACE"
                               Foreground="{StaticResource FayeTextSecondary}"
                               FontSize="14"/>
                    <StackPanel Grid.Row="2"
                                Orientation="Vertical">
                        <TextBlock Text="Good afternoon, boss!"
                                   Foreground="{StaticResource FayeTextPrimary}"
                                   FontSize="28"
                                   FontWeight="Light"/>
                        <TextBlock Text="How can I assist you today?"
                                   Foreground="{StaticResource FayeTextSecondary}"
                                   FontSize="15"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                    <Border Grid.Row="3"
                            Background="#3010243a"
                            Margin="0,25,0,20"
                            CornerRadius="14"
                            Padding="18">
                        <StackPanel x:Name="ConversationPanel"
                                    Orientation="Vertical"/>
                    </Border>
                    <Border Grid.Row="4"
                            Background="#5010243a"
                            CornerRadius="14"
                            Padding="14"
                            BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{StaticResource FayeBorder}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding ="{Binding ElementName=CommandTextBox, Path=IsKeyboardFocused}"
                                                 Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource FayeAccent}"/>
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#4da3ff" BlurRadius="12" ShadowDepth="0" Opacity="0.65"/>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource FayeAccent}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBox x:Name="CommandTextBox"
                                   Style="{StaticResource FayeCommandTextBoxStyle}"
                                   KeyDown="CommandTextBox_KeyDown"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
